#compdef nullfetch

_nullfetch() {
    _arguments \
        '(-h --help)'{-h,--help}'[show help]' \
        '--version[show version]' \
        '--no-logo[hide the ASCII logo]' \
        '--logo[logo to show]:logo:(auto none arch cat cactus coffee computer cow debian frog ghost linux moon penguin robot rocket skull tree ubuntu void)' \
        '--no-color[disable colors]' \
        '(-o --only)'{-o,--only}'[show only these fields]:fields:(user host os kernel cpu gpu ram disk)' \
        '--json[print system info as JSON]'
}

_nullfetch
